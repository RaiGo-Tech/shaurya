{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "shaurya",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "build/web",
  "installCommand": "npm install --ignore-scripts",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
